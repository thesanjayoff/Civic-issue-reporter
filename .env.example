# Copy this file to .env.local and fill in real values for your environment.
# Never commit .env.local — it is gitignored.

# --- Database (PostgreSQL + PostGIS) ---
# Local dev default matches `npm run db:up` (podman/docker postgis container).
DATABASE_URL=postgres://ooru_kural:ooru_kural_dev@localhost:5432/ooru_kural

# --- Auth / sessions ---
# 32+ byte random secret used to sign session cookies (jose/JWT). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=dev-only-insecure-secret-change-me-32-bytes-min

# --- Map tiles ---
# MapLibre vector tile source. Terms must explicitly allow this use — do not point
# this at OpenStreetMap's own tile servers (tile.openstreetmap.org), whose usage
# policy forbids third-party app traffic. Default below uses MapLibre's own public
# demo tiles, which are documented as fine for development/evaluation only.
# For a real deployment, sign up for a tile provider with a free/paid tier whose ToS
# cover this use case (e.g. MapTiler Cloud, Stadia Maps, Mapbox) and set:
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
# NEXT_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY

# --- Vision/text classification provider (optional) ---
# Any AI SDK "provider/model" string reachable via Vercel AI Gateway or a direct
# provider key. If unset, the app falls back to a deterministic keyword heuristic
# classifier (lower accuracy, documented in README's evaluation section).
CLASSIFIER_MODEL=
AI_GATEWAY_API_KEY=

# --- Voice transcription provider (optional) ---
# Adapter name: "bhashini" | "sarvam" | "browser" (Web Speech API, client-side only)
VOICE_PROVIDER=browser
BHASHINI_API_KEY=
SARVAM_API_KEY=

# --- Messaging bot channels (optional, disabled unless keys set) ---
WHATSAPP_BUSINESS_TOKEN=
TELEGRAM_BOT_TOKEN=

# --- Open311 connector ---
# Comma-separated list is not used; per-authority endpoints live in DB (see
# src/lib/open311). This flag is a global kill switch.
OPEN311_ENABLED=false
